# TMDB API Credentials (v3 32-char hex key OR v4 Bearer Read Access Token)
TMDB_API_KEY=your_tmdb_api_key_here

# Better Auth Secret (Generate via `openssl rand -hex 32`)
BETTER_AUTH_SECRET=your_32_character_random_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Resend API Key for Email Delivery
RESEND_API_KEY=re_your_resend_api_key_here
